  pacienteId String? @map("paciente_id")
  terapeutaId String? @map("terapeuta_id")
  terapia Terapia @relation("Agenda_terapiaId_clinicId", fields: [terapiaId, clinicId], references: [id, clinicId], onDelete: Restrict)
  therapistMembership Membership @relation("Agenda_therapistMembershipId_clinicId", fields: [therapistMembershipId, clinicId], references: [id, clinicId], onDelete: Restrict)
  patientMembership Membership @relation("Agenda_patientMembershipId_clinicId", fields: [patientMembershipId, clinicId], references: [id, clinicId], onDelete: Restrict)
  terapeuta Terapeuta? @relation("Agenda_terapeutaId", fields: [terapeutaId], references: [id], onDelete: NoAction)
  paciente Paciente? @relation("Agenda_pacienteId", fields: [pacienteId], references: [id], onDelete: NoAction)
  cancelledByUser Usuario? @relation("Agenda_cancelledByUserId", fields: [cancelledByUserId], references: [id], onDelete: SetNull)
  clinic Clinica @relation("Agenda_clinicId", fields: [clinicId], references: [id], onDelete: Restrict)
  atendimentoByAgenda Atendimento[] @relation("Atendimento_agendaId_clinicId")
  pagamentoByAgenda Pagamento[] @relation("Pagamento_agendaId_clinicId")
  appointmentEventByAppointment AppointmentEvent[] @relation("AppointmentEvent_appointmentId")
  @@unique([id, clinicId], map: "appointments_id_clinic_unique_idx")
  @@index([patientMembershipId, dtInicio, status], map: "appointments_patient_start_idx")
  @@index([therapistMembershipId, dtInicio, status], map: "appointments_therapist_start_idx")
  @@index([clinicId, dtInicio, status], map: "appointments_clinic_start_idx")
  @@map("AGENDA")
}

